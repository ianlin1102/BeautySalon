<view wx:if="{{!isLoad}}" class="margin-top load loading text-l text-admin"></view>

<view class="main-admin" wx:if="{{isAdmin&&isLoad}}">

	<!-- Tab 切换 -->
	<view class="tab-bar">
		<view class="tab-item {{currentTab === 'card_terms' ? 'active' : ''}}"
			  bindtap="bindTabChange" data-tab="card_terms">
			卡项条款
		</view>
		<view class="tab-item {{currentTab === 'user_terms' ? 'active' : ''}}"
			  bindtap="bindTabChange" data-tab="user_terms">
			用户条款
		</view>
		<view class="tab-item {{currentTab === 'booking_terms' ? 'active' : ''}}"
			  bindtap="bindTabChange" data-tab="booking_terms">
			预约条款
		</view>
	</view>

	<!-- Header 区域（第一项，isHeader=true） -->
	<view wx:if="{{sections.length > 0 && sections[0].isHeader}}" class="section-item form-box shadow header-card">
		<view class="section-header">
			<text class="section-num header-badge">标题 / Header</text>
		</view>

		<view class="field-group">
			<text class="field-label lang-zh">标题（中文）</text>
			<input class="field-input" value="{{sections[0].header_zh}}" bindinput="bindHeaderZhInput" placeholder="中文标题" maxlength="100" />
		</view>
		<view class="field-group">
			<text class="field-label lang-en">Title (EN)</text>
			<input class="field-input" value="{{sections[0].header_en}}" bindinput="bindHeaderEnInput" placeholder="English Title" maxlength="100" />
		</view>
		<view class="field-group">
			<text class="field-label lang-zh">引言（中文）</text>
			<textarea class="field-textarea" value="{{sections[0].intro_zh}}" bindinput="bindIntroZhInput" placeholder="中文引言" auto-height maxlength="2000" />
		</view>
		<view class="field-group">
			<text class="field-label lang-en">Introduction (EN)</text>
			<textarea class="field-textarea" value="{{sections[0].intro_en}}" bindinput="bindIntroEnInput" placeholder="English Introduction" auto-height maxlength="2000" />
		</view>
	</view>

	<!-- 条款列表（跳过 isHeader） -->
	<view class="section-list">
		<view class="section-item form-box shadow" wx:for="{{sections}}" wx:key="index" wx:if="{{!item.isHeader}}">
			<view class="section-header">
				<text class="section-num">条款 {{index}}</text>
				<text class="section-del" bindtap="bindDelSection" data-idx="{{index}}">删除</text>
			</view>

			<view class="field-group">
				<text class="field-label lang-zh">中文标题</text>
				<input class="field-input" value="{{item.title_zh || item.title || ''}}" data-idx="{{index}}" bindinput="bindTitleZhInput" placeholder="中文标题" maxlength="50" />
			</view>
			<view class="field-group">
				<text class="field-label lang-en">EN Title</text>
				<input class="field-input" value="{{item.title_en || ''}}" data-idx="{{index}}" bindinput="bindTitleEnInput" placeholder="English Title" maxlength="50" />
			</view>
			<view class="field-group">
				<text class="field-label lang-zh">中文内容</text>
				<textarea class="field-textarea" value="{{item.content_zh || item.content || ''}}" data-idx="{{index}}" bindinput="bindContentZhInput" placeholder="中文内容" auto-height maxlength="5000" />
			</view>
			<view class="field-group">
				<text class="field-label lang-en">EN Content</text>
				<textarea class="field-textarea" value="{{item.content_en || ''}}" data-idx="{{index}}" bindinput="bindContentEnInput" placeholder="English Content" auto-height maxlength="5000" />
			</view>
		</view>
	</view>

	<!-- 空状态 -->
	<view class="empty-tip" wx:if="{{sections.length === 0}}">
		<text>暂无条款内容，点击下方按钮添加</text>
	</view>

	<!-- 操作按钮 -->
	<view class="action-bar">
		<button class="btn-add" bindtap="bindAddSection">+ 添加条款</button>
		<button class="btn-reset" bindtap="bindResetDefault">恢复默认</button>
	</view>

	<!-- 版本信息（仅用户条款显示） -->
	<view class="version-info" wx:if="{{currentTab === 'user_terms'}}">
		<text>当前版本：V{{currentVersion || 0}}</text>
		<text class="version-tip">（保存后版本号自动+1，用户需重新同意）</text>
	</view>

	<!-- 底部占位，防止内容被固定按钮遮挡 -->
	<view class="bottom-placeholder"></view>

</view>

<!-- 固定在底部的保存按钮 -->
<view class="fixed-save-bar" wx:if="{{isAdmin&&isLoad}}">
	<button bindtap="bindFormSubmit" class="save-btn">保存</button>
</view>
