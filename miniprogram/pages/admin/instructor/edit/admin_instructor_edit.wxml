<view wx:if="{{isLoad==false}}" class="margin-top load loading text-l text-grey"></view>
<view wx:elif="{{isLoad==null}}" class="margin-top load text-grey">
	<text class="icon-warn"></text> 无此数据
</view>
<view class="main-admin" wx:elif="{{isAdmin&&isLoad}}">

	<view class="form-box shadow">
		<view class="form-group">
			<view class="title must">导师姓名</view>
			<input placeholder="请输入导师姓名" placeholder-class="phc" value="{{formName}}" bindinput="model" data-item="formName" maxlength="20"></input>
		</view>

		<view class="form-group">
			<view class="title">English Name<text class="text-grey text-normal margin-left-xs">(可选)</text></view>
			<input placeholder="Instructor name in English" placeholder-class="phc" value="{{formNameEn}}" bindinput="model" data-item="formNameEn" maxlength="50"></input>
		</view>

		<view class="form-group">
			<view class="title must">导师头像</view>
		</view>

		<view class="form-group">
			<cmpt-img-upload imgMax="{{1}}" title="头像上传" isCheck="{{false}}" imgUploadSize="{{10}}" imgList="{{imgList}}" bind:upload="bindImgUploadCmpt" />
		</view>

		<view class="form-group">
			<view class="title">专长<text class="text-grey text-normal margin-left-xs">(可选)</text></view>
			<input placeholder="如：Hip-Hop" placeholder-class="phc" value="{{formSpecialty}}" bindinput="model" data-item="formSpecialty" maxlength="50"></input>
		</view>

		<view class="form-group">
			<view class="title">Specialty (English)<text class="text-grey text-normal margin-left-xs">(可选)</text></view>
			<input placeholder="e.g. Hip-Hop" placeholder-class="phc" value="{{formSpecialtyEn}}" bindinput="model" data-item="formSpecialtyEn" maxlength="50"></input>
		</view>

		<view class="form-group align-start">
			<view class="title">简介<text class="text-grey text-normal margin-left-xs">(可选)</text></view>
			<textarea placeholder="请输入简介" placeholder-class="phc" value="{{formDesc}}" bindinput="model" data-item="formDesc" maxlength="100" style="min-height:120rpx" auto-height="true"></textarea>
		</view>

		<view class="form-group align-start">
			<view class="title">Bio (English)<text class="text-grey text-normal margin-left-xs">(可选)</text></view>
			<textarea placeholder="Short bio in English" placeholder-class="phc" value="{{formDescEn}}" bindinput="model" data-item="formDescEn" maxlength="200" style="min-height:120rpx" auto-height="true"></textarea>
		</view>

		<view class="form-group">
			<view class="title must">排序号<text class="text-grey text-normal margin-left-xs">(数字越小越靠前)</text></view>
			<input placeholder="1-9999" type="digit" placeholder-class="phc" value="{{formOrder}}" bindinput="model" data-item="formOrder"></input>
		</view>

	</view>

	<button bindtap="bindFormSubmit" class="btn-admin margin-top-xs">提交</button>

</view>
