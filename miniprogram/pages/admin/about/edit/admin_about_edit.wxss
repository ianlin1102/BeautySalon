@import '../../../../style/project/base/admin.wxss';

/* Instructor slot */
.instructor-slot {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 20rpx 24rpx;
	border-bottom: 1rpx solid #eee;
}

.instructor-slot-info {
	display: flex;
	align-items: center;
	gap: 16rpx;
}

.instructor-slot-avatar {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
}

.instructor-slot-name {
	font-size: 30rpx;
	font-weight: 500;
}

.instructor-slot-remove {
	width: 56rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 36rpx;
	color: #999;
	border-radius: 50%;
	background: #f5f5f5;
}

/* Instructor picker modal */
.picker-mask {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(0, 0, 0, 0.5);
	z-index: 999;
	display: flex;
	align-items: flex-end;
}

.picker-content {
	width: 100%;
	max-height: 70vh;
	background: #fff;
	border-radius: 24rpx 24rpx 0 0;
	overflow: hidden;
}

.picker-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 30rpx;
	border-bottom: 1rpx solid #eee;
}

.picker-close {
	font-size: 40rpx;
	color: #999;
	padding: 0 10rpx;
}

.picker-list {
	max-height: 60vh;
}

.picker-item {
	display: flex;
	align-items: center;
	padding: 24rpx 30rpx;
	border-bottom: 1rpx solid #f5f5f5;
	gap: 16rpx;
}

.picker-item.picked {
	background: #f0ebff;
}

.picker-avatar {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
}

.picker-name {
	flex: 1;
	font-size: 30rpx;
}

.picker-check {
	color: #7C3AED;
	font-size: 36rpx;
	font-weight: bold;
}
