@import '../../../../style/project/base/admin.wxss';

page {
	background-color: #f8f8f8;
}

.form-hint {
	font-size: 22rpx;
	color: #999;
	padding: 8rpx 10rpx;
}

.status-switch {
	display: flex;
	align-items: center;
	gap: 16rpx;
}

.status-text {
	font-size: 28rpx;
	color: #555;
}

/* 区域标签 */
.section-label {
	font-size: 28rpx;
	color: #666;
	font-weight: bold;
	margin-bottom: 16rpx;
}

/* 已选中用户 */
.selected-user {
	display: flex;
	align-items: center;
	padding: 24rpx 30rpx;
}

.selected-info {
	flex: 1;
}

.selected-name {
	font-size: 30rpx;
	color: #333;
	font-weight: bold;
	margin-bottom: 6rpx;
}

.selected-phone {
	font-size: 26rpx;
	color: #666;
	margin-bottom: 4rpx;
}

.selected-openid {
	font-size: 22rpx;
	color: #999;
	word-break: break-all;
}

.selected-clear {
	width: 60rpx;
	height: 60rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #ccc;
	font-size: 32rpx;
}

/* 用户搜索栏 */
.user-search-bar {
	display: flex;
	align-items: center;
	gap: 16rpx;
	margin-bottom: 16rpx;
}

.user-search-input {
	flex: 1;
	height: 72rpx;
	background: #fff;
	border-radius: 40rpx;
	padding: 0 30rpx;
	color: #333;
	font-size: 28rpx;
	border: 1rpx solid #e0e0e0;
}

.user-search-btn {
	height: 72rpx;
	padding: 0 36rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background: var(--adminColor);
	border-radius: 40rpx;
	color: #fff;
	font-size: 28rpx;
}

/* 搜索结果 */
.user-result-hint {
	text-align: center;
	color: #999;
	padding: 40rpx 0;
	font-size: 26rpx;
}

.user-result-item {
	display: flex;
	align-items: center;
	padding: 24rpx 30rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.user-result-item:last-child {
	border-bottom: none;
}

.user-result-main {
	flex: 1;
}

.user-result-name {
	font-size: 28rpx;
	color: #333;
	font-weight: bold;
	margin-bottom: 4rpx;
}

.user-result-detail {
	font-size: 24rpx;
	color: #999;
}

.user-result-arrow {
	color: #ccc;
	font-size: 28rpx;
}
