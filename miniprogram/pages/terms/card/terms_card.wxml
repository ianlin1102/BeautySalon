<view wx:if="{{!isLoad}}" class="load loading text-l"></view>

<view class="terms-page" wx:if="{{isLoad}}">
	<view class="terms-header">
		<text class="terms-title">卡项购买条款</text>
	</view>

	<scroll-view class="terms-content" scroll-y>
		<block wx:for="{{sections}}" wx:key="index">
			<view class="terms-section">
				<view class="section-title">{{item.title}}</view>
				<view class="section-content">{{item.content}}</view>
			</view>
		</block>

		<view wx:if="{{sections.length === 0}}" class="empty-hint">
			<text>暂无条款内容</text>
		</view>
	</scroll-view>
</view>
