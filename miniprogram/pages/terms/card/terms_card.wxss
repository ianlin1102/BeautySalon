.terms-page {
	min-height: 100vh;
	background: #f5f5f5;
}

.terms-header {
	padding: 30rpx;
	background: #fff;
	text-align: center;
	border-bottom: 1rpx solid #eee;
}

.terms-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #333;
}

.terms-content {
	padding: 30rpx;
	background: #fff;
	margin: 20rpx;
	border-radius: 10rpx;
	min-height: 60vh;
}

.terms-section {
	margin-bottom: 40rpx;
}

.section-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 20rpx;
}

.section-content {
	font-size: 28rpx;
	color: #666;
	line-height: 1.8;
	white-space: pre-wrap;
}

.empty-hint {
	text-align: center;
	padding: 100rpx;
	color: #999;
	font-size: 28rpx;
}
