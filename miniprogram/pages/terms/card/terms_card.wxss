@import "../../../style/project/neon_theme.wxss";
@import "../../../projects/A00/skin/skin.wxss";

page {
	background-color: #050511;
}

.content-area {
	position: relative;
	z-index: 1;
	padding-top: 30rpx;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
}

.terms-content-scroll {
	height: 70vh;
	width: 100%;
}

.content-line {
	line-height: 1.8;
	white-space: pre-wrap;
}

.glass-panel .title {
	font-size: 34rpx;
	font-weight: bold;
	text-align: center;
	padding: 30rpx 0;
}

/* 语言切换 */
.lang-toggle {
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 16rpx 0;
	margin-bottom: 20rpx;
}

.lang-btn {
	font-size: 26rpx;
	color: rgba(255,255,255,0.4);
	padding: 8rpx 20rpx;
}

.lang-btn.active {
	color: #06b6d4;
	font-weight: bold;
}

.lang-divider {
	color: rgba(255,255,255,0.2);
	margin: 0 8rpx;
}

/* 条款头部 */
.terms-header {
	margin-bottom: 30rpx;
}

.terms-main-title {
	font-size: 34rpx;
	font-weight: bold;
	color: #06b6d4;
	text-align: center;
	margin-bottom: 20rpx;
}

.terms-intro {
	font-size: 28rpx;
	color: rgba(255,255,255,0.7);
	line-height: 1.6;
	white-space: pre-wrap;
}

.empty-hint {
	text-align: center;
	padding: 100rpx;
	color: rgba(255,255,255,0.4);
	font-size: 28rpx;
}
