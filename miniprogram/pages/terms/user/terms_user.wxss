@import "../../../style/project/neon_theme.wxss";
@import "../../../projects/A00/skin/skin.wxss";

page {
	background-color: #050511;
}

.content-area {
	position: relative;
	z-index: 1;
	padding-top: 30rpx;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
}

.terms-content-scroll {
	height: 55vh;
	width: 100%;
}

.content-line {
	line-height: 1.8;
	white-space: pre-wrap;
}

.disabled-area {
	opacity: 0.3;
	pointer-events: none;
}

.glass-panel .title {
	font-size: 34rpx;
	font-weight: bold;
	text-align: center;
	padding: 30rpx 0;
}

.scroll-hint {
	text-align: center;
	padding: 30rpx;
	color: #00f2ff;
	font-size: 26rpx;
	text-shadow: 0 0 10rpx rgba(0, 242, 255, 0.5);
}

/* 语言切换 */
.lang-toggle {
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 16rpx 0;
	margin-bottom: 20rpx;
}

.lang-btn {
	font-size: 26rpx;
	color: rgba(255,255,255,0.4);
	padding: 8rpx 20rpx;
}

.lang-btn.active {
	color: #06b6d4;
	font-weight: bold;
}

.lang-divider {
	color: rgba(255,255,255,0.2);
	margin: 0 8rpx;
}

/* 条款头部 */
.terms-header {
	margin-bottom: 30rpx;
}

.terms-main-title {
	font-size: 34rpx;
	font-weight: bold;
	color: #06b6d4;
	text-align: center;
	margin-bottom: 20rpx;
}

.terms-intro {
	font-size: 28rpx;
	color: rgba(255,255,255,0.7);
	line-height: 1.6;
	white-space: pre-wrap;
}

/* 霓虹表单样式 */
.neon-form-group {
	padding: 20rpx 10rpx;
	display: flex;
	align-items: center;
	justify-content: space-between;
	border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.neon-form-group .title {
	font-size: 30rpx;
	padding: 0;
	text-align: left;
}

.neon-form-group .title.must::before {
	color: #ff00de;
	content: "*";
	margin-right: 5rpx;
}

.neon-input {
	flex: 1;
	text-align: right;
	color: #fff;
	font-size: 30rpx;
}

.phc {
	color: rgba(255, 255, 255, 0.2);
}

.neon-checkbox {
	transform: scale(0.9);
}

/* 覆盖 neon-button 禁用状态 */
.neon-button[disabled] {
	background: rgba(255, 255, 255, 0.1) !important;
	color: rgba(255, 255, 255, 0.3) !important;
	box-shadow: none !important;
}

/* 已同意状态保持绿色但增加发光 */
.text-green {
	color: #00ff88 !important;
	text-shadow: 0 0 15rpx rgba(0, 255, 136, 0.4);
}

.bg-green {
	background-color: #00ff88 !important;
	color: #050511 !important;
	font-weight: bold;
	box-shadow: 0 0 20rpx rgba(0, 255, 136, 0.3);
}