<view wx:if="{{!isLoad}}" class="load loading text-l load-project"></view>

<view class="neon-page" wx:if="{{isLoad}}">
	<!-- 背景装饰光斑 -->
	<view class="bg-glow bg-glow-1"></view>
	<view class="bg-glow bg-glow-2"></view>

	<view class="content-area padding-project">
		<view class="glass-panel padding-project margin-top">
			<view class="title text-neon-primary text-bold">预约须知条款</view>

			<!-- Language Toggle -->
			<view class="lang-toggle" bindtap="bindLanguageToggle">
				<text class="lang-btn {{language === 'zh' ? 'active' : ''}}">中文</text>
				<text class="lang-divider">|</text>
				<text class="lang-btn {{language === 'en' ? 'active' : ''}}">EN</text>
			</view>

			<scroll-view class="terms-content-scroll" scroll-y>
				<view class="padding-top-s">
					<!-- Header section -->
					<view wx:if="{{sections.length > 0 && sections[0].isHeader}}" class="terms-header">
						<view class="terms-main-title">{{language === 'zh' ? (sections[0].header_zh || sections[0].header_en) : (sections[0].header_en || sections[0].header_zh)}}</view>
						<view class="terms-intro">{{language === 'zh' ? (sections[0].intro_zh || sections[0].intro_en) : (sections[0].intro_en || sections[0].intro_zh)}}</view>
					</view>

					<!-- Regular sections -->
					<block wx:for="{{sections}}" wx:key="index">
						<view class="margin-bottom-xl" wx:if="{{!item.isHeader}}">
							<view class="text-neon-white text-bold text-m margin-bottom-s">{{language === 'zh' ? (item.title_zh || item.title) : (item.title_en || item.title_zh || item.title)}}</view>
							<view class="text-neon-muted text-m content-line">{{language === 'zh' ? (item.content_zh || item.content) : (item.content_en || item.content_zh || item.content)}}</view>
						</view>
					</block>

					<view wx:if="{{sections.length === 0}}" class="empty-hint">
						<text>暂无条款内容</text>
					</view>
				</view>
			</scroll-view>
		</view>
	</view>
</view>
