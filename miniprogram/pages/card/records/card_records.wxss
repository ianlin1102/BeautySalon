.container {
	min-height: 100vh;
	background-color: #f5f5f5;
	padding: 20rpx;
}

.section {
	background: #fff;
	border-radius: 16rpx;
	padding: 30rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
	color: #333;
	font-size: 28rpx;
	font-weight: bold;
	margin-bottom: 20rpx;
}

/* 卡项信息 */
.card-info-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.card-info-name {
	font-size: 34rpx;
	font-weight: bold;
	color: #333;
}

.card-info-status {
	font-size: 22rpx;
	padding: 6rpx 16rpx;
	border-radius: 20rpx;
}

.card-info-status.status-1 {
	background: #e8f5e9;
	color: #4caf50;
}

.card-info-status.status-0 {
	background: #fafafa;
	color: #999;
}

.card-info-status.status-2 {
	background: #ffebee;
	color: #f44336;
}

.card-info-id {
	font-size: 24rpx;
	color: #999;
	margin-top: 8rpx;
}

.card-info-balance {
	margin-top: 24rpx;
	padding: 24rpx;
	background: #f8f9fa;
	border-radius: 12rpx;
	text-align: center;
}

.balance-main {
	display: flex;
	align-items: baseline;
	justify-content: center;
	gap: 8rpx;
}

.balance-main .balance-num {
	font-size: 52rpx;
	font-weight: bold;
	color: #7C3AED;
}

.balance-main .balance-unit {
	font-size: 26rpx;
	color: #666;
}

.balance-sub {
	font-size: 24rpx;
	color: #999;
	margin-top: 8rpx;
}

.card-info-meta {
	margin-top: 20rpx;
	border-top: 1rpx solid #f0f0f0;
	padding-top: 20rpx;
}

.meta-item {
	display: flex;
	justify-content: space-between;
	padding: 10rpx 0;
}

.meta-label {
	font-size: 26rpx;
	color: #999;
}

.meta-value {
	font-size: 26rpx;
	color: #333;
}

/* 记录列表 */
.records-list {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.record-item {
	background: #f9f9f9;
	border-radius: 12rpx;
	padding: 20rpx;
	border-left: 4rpx solid #7C3AED;
}

.record-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 12rpx;
}

.record-type {
	padding: 6rpx 14rpx;
	border-radius: 20rpx;
	font-size: 22rpx;
	color: #fff;
}

.type-1 { background: #67c23a; }
.type-2 { background: #f56c6c; }
.type-3 { background: #e6a23c; }
.type-4 { background: #909399; }

.record-time {
	font-size: 22rpx;
	color: #999;
}

.record-content {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.record-change {
	display: flex;
	align-items: center;
	gap: 8rpx;
}

.change-label {
	font-size: 24rpx;
	color: #666;
}

.change-value {
	font-size: 28rpx;
	font-weight: bold;
}

.change-value.positive { color: #67c23a; }
.change-value.negative { color: #f56c6c; }

.record-balance {
	display: flex;
	align-items: center;
	gap: 8rpx;
	font-size: 22rpx;
	color: #666;
}

.record-balance .balance-label {
	font-size: 20rpx;
	color: #999;
}

.record-balance .balance-value {
	font-size: 22rpx;
	color: #333;
	font-weight: bold;
}

.balance-arrow {
	color: #999;
	margin: 0 4rpx;
}

.record-reason {
	display: flex;
	gap: 8rpx;
	padding-top: 8rpx;
	border-top: 1rpx solid #e0e0e0;
}

.reason-label {
	font-size: 22rpx;
	color: #999;
}

.reason-text {
	flex: 1;
	font-size: 22rpx;
	color: #666;
	line-height: 1.6;
}

.record-admin {
	display: flex;
	gap: 8rpx;
	align-items: center;
}

.admin-label {
	font-size: 20rpx;
	color: #999;
}

.admin-name {
	font-size: 22rpx;
	color: #7C3AED;
	font-weight: bold;
}

/* 空状态 */
.empty-state {
	text-align: center;
	padding: 100rpx 0;
}

.empty-text {
	font-size: 26rpx;
	color: #999;
}

/* 加载状态 */
.loading,
.no-more {
	text-align: center;
	padding: 30rpx 0;
	font-size: 24rpx;
	color: #999;
}

.load-more {
	text-align: center;
	padding: 30rpx 0;
	font-size: 26rpx;
	color: #7C3AED;
}
