@import "../../../../style/project/base/article_list.wxss";
@import "../../skin/skin.wxss";
@import "../../../../style/project/my_join_detail_base.wxss";
@import "../../../../style/project/neon_theme.wxss";

/* ========== 页面级霓虹样式 ========== */

page {
	background-color: #0a0a1a !important;
}

.main {
	padding: 0 20rpx !important;
}

/* ========== 预约信息卡片 ========== */
.text-pic-list-box {
	padding: 30rpx 0rpx 20rpx;
}

.text-pic-list-box .item {
	background: linear-gradient(145deg, rgba(20, 20, 40, 0.9), rgba(30, 30, 50, 0.8)) !important;
	backdrop-filter: blur(20px);
	-webkit-backdrop-filter: blur(20px);
	border: 1rpx solid rgba(115, 189, 245, 0.15) !important;
	border-radius: 24rpx !important;
	padding: 30rpx !important;
	box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3),
		inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

/* 标题行 */
.text-pic-list-box .title-line {
	margin-bottom: 20rpx;
	padding-bottom: 20rpx;
	border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.text-pic-list-box .title-line .title {
	color: #fff !important;
	font-size: 34rpx !important;
	font-weight: 600;
	text-shadow: 0 0 20rpx rgba(115, 189, 245, 0.3);
}

.text-pic-list-box .title-line .arrow {
	color: rgba(115, 189, 245, 0.6) !important;
}

/* 时间信息 */
.text-pic-list-box .item .author {
	color: rgba(255, 255, 255, 0.7) !important;
	font-size: 28rpx;
	margin-bottom: 20rpx;
	display: flex;
	align-items: center;
}

.text-pic-list-box .item .author .icon-remind {
	color: #73bdf5 !important;
}

/* 状态信息 */
.text-pic-list-box .item .data {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 16rpx;
}

.text-pic-list-box .item .data .text-green {
	color: #2dd4bf !important;
	text-shadow: 0 0 10rpx rgba(45, 212, 191, 0.4);
}

.text-pic-list-box .item .data .text-grey {
	color: rgba(255, 255, 255, 0.5) !important;
}

.text-pic-list-box .item .data .text-orange {
	color: #fbbf24 !important;
	text-shadow: 0 0 10rpx rgba(251, 191, 36, 0.4);
}

/* 取消按钮 */
.text-pic-list-box .item .data .btn.bg-grey {
	background: rgba(248, 113, 113, 0.15) !important;
	color: #f87171 !important;
	border: 1rpx solid rgba(248, 113, 113, 0.3) !important;
	border-radius: 30rpx !important;
	padding: 10rpx 24rpx !important;
}

/* 操作按钮区 */
.text-pic-list-box .item .oprt {
	margin-top: 30rpx;
	padding-top: 20rpx;
	border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.text-pic-list-box .item .oprt .btn {
	background: linear-gradient(135deg, rgba(115, 189, 245, 0.2), rgba(189, 0, 255, 0.15)) !important;
	color: #73bdf5 !important;
	border: 1rpx solid rgba(115, 189, 245, 0.3) !important;
	border-radius: 30rpx !important;
	padding: 16rpx 32rpx !important;
	font-size: 26rpx;
	transition: all 0.3s ease;
}

.text-pic-list-box .item .oprt .btn:active {
	transform: scale(0.98);
	background: linear-gradient(135deg, rgba(115, 189, 245, 0.3), rgba(189, 0, 255, 0.25)) !important;
}

/* ========== 信息列表卡片 ========== */
.info-list-box .item {
	background: linear-gradient(145deg, rgba(20, 20, 40, 0.9), rgba(30, 30, 50, 0.8)) !important;
	backdrop-filter: blur(20px);
	-webkit-backdrop-filter: blur(20px);
	border: 1rpx solid rgba(115, 189, 245, 0.15) !important;
	border-radius: 24rpx !important;
	padding: 30rpx !important;
	box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3),
		inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.info-list-box .item .info {
	color: rgba(255, 255, 255, 0.8) !important;
	border-bottom: 1rpx dashed rgba(255, 255, 255, 0.1) !important;
	padding: 16rpx 0 !important;
}

.info-list-box .item .info:last-child,
.info-list-box .item .info:first-child {
	border-bottom: none !important;
}

.info-list-box .item .info .title {
	color: rgba(255, 255, 255, 0.5) !important;
	font-weight: 500 !important;
}

.info-list-box .item .info .content {
	color: #fff !important;
}

.info-list-box .item .info .center {
	color: #fff !important;
}

.info-list-box .item .info .center .text-bold {
	color: #73bdf5 !important;
	font-size: 32rpx;
}

/* 预约码图片 */
.info-list-box .item .info .center image {
	border-radius: 16rpx;
	box-shadow: 0 0 30rpx rgba(115, 189, 245, 0.2);
	background: #fff;
	padding: 20rpx;
}

/* 提交时间 */
.info-list-box .item .info.text-grey {
	color: rgba(255, 255, 255, 0.4) !important;
}

/* ========== 加载状态 ========== */
.load-project {
	color: rgba(255, 255, 255, 0.5) !important;
}

/* ========== 图标颜色 ========== */
.icon-newshot {
	color: #2dd4bf !important;
}

.icon-bad {
	color: #f87171 !important;
}

.icon-info {
	color: rgba(255, 255, 255, 0.4) !important;
}

.icon-close {
	color: #f87171 !important;
}
