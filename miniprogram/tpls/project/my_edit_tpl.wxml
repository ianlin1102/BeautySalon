<template name="myEditTpl">
	<view wx:if="{{isLoad===null}}" class="margin-top load notexist text-l load-project"></view>
	<view wx:if="{{isLoad===false}}" class="margin-top load loading text-l load-project"></view>

	<view wx:if="{{isLoad}}" class="main padding-project">
		<!-- 头像选择 -->
		<view class="form-box shadow-project" style="margin-bottom: 20rpx;">
			<view class="form-group" style="display:flex; align-items:center; justify-content:space-between;">
				<view class="title">头像</view>
				<button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="bindChooseAvatar">
					<image class="avatar-preview" src="{{formAvatar || '../../skin/images/tabbar_icon/profile_cur.png'}}" mode="aspectFill" />
					<text class="text-grey text-s margin-left-xs">点击更换</text>
				</button>
			</view>
		</view>

		<view class="form-box shadow-project">
			<view class="form-group">
				<view class="title ">*姓名</view>
				<input type="nickname" placeholder="填写您的姓名（点击获取微信昵称）" placeholder-class="phc" model:value="{{formName}}" maxlength="20" bindchange="bindNicknameChange"></input>
			</view>
			<view wx:if="{{formNameFocus}}" class="hint-desc error">{{formNameFocus}}</view>

			<view class="form-group">
				<view class="title ">*手机</view>
				<view class="phone-input-row">
					<picker class="country-code-picker" mode="selector" range="{{countryCodes}}" range-key="label" value="{{countryCodeIndex || 0}}" bindchange="onCountryCodeChange">
						<view class="country-code-display">
							{{countryCodes && countryCodes.length > 0 ? countryCodes[countryCodeIndex || 0].label : '+1 (美国)'}}
							<text class="arrow">▼</text>
						</view>
					</picker>
					<input class="phone-input" placeholder="填写手机号" placeholder-class="phc" model:value="{{formMobile}}" type="number" maxlength="15"></input>
				</view>
			</view>
			<view wx:if="{{formMobileFocus}}" class="hint-desc error">{{formMobileFocus}}</view>

			<view class="form-group">
				<view class="title">所在城市</view>
				<input placeholder="填写您的所在城市" placeholder-class="phc" model:value="{{formCity}}" maxlength="100"></input>
			</view>
			<view wx:if="{{formCityFocus}}" class="hint-desc error">{{formCityFocus}}</view>

			<view class="form-group">
				<view class="title">所在单位</view>
				<input placeholder="填写您的所在单位" placeholder-class="phc" model:value="{{formWork}}" maxlength="100"></input>
			</view>
			<view wx:if="{{formWorkFocus}}" class="hint-desc error">{{formWorkFocus}}</view>

			<view class="form-group">
				<view class="title">行业领域</view>
				<input placeholder="填写您的行业领域" placeholder-class="phc" model:value="{{formTrade}}" maxlength="100"></input>
			</view>
			<view wx:if="{{fformTradeFocus}}" class="hint-desc error">{{fformTradeFocus}}</view>

		</view>

		<button bindtap="bindSubmitTap" class="btn-base btn-project">提交</button>
	</view>

</template>