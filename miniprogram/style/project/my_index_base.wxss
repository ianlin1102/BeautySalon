/* ========== My Index - Neon Theme Base Styles ========== */
@import "./neon_theme.wxss";

/* 页面背景 - 夜店深空黑 */
.neon-page {
	background-color: #050511;
	min-height: 100vh;
	padding: 0;
	position: relative;
	overflow: hidden;
}

/* 背景光斑 - 动态氛围 */
.bg-glow {
	position: fixed;
	border-radius: 50%;
	pointer-events: none;
	z-index: 0;
	filter: blur(160rpx);
}

.bg-glow-1 {
	top: -100rpx;
	left: -100rpx;
	width: 500rpx;
	height: 500rpx;
	opacity: 0.5;
	background: radial-gradient(circle, #00f2ff 0%, transparent 70%);
	animation: pulse-glow 6s infinite alternate;
}

.bg-glow-2 {
	top: 600rpx;
	right: -120rpx;
	width: 400rpx;
	height: 400rpx;
	opacity: 0.4;
	background: radial-gradient(circle, #00f2ff 0%, transparent 70%);
	animation: pulse-glow 5s infinite alternate-reverse;
}

/* 主内容区域 */
.content-area {
	position: relative;
	z-index: 10;
	padding: 40rpx 30rpx;
	padding-top: 180rpx; /* 向下移动约100px */
	display: flex;
	flex-direction: column;
	gap: 40rpx;
}

/* ========== 用户头像与等级进度条 ========== */
.user-section {
	display: flex;
	align-items: center;
	gap: 30rpx;
	padding: 40rpx;
	border-radius: 40rpx;
	background: rgba(255, 255, 255, 0.03);
	border: 1rpx solid rgba(255, 255, 255, 0.05);
	backdrop-filter: blur(10px);
	-webkit-backdrop-filter: blur(10px);
}

.avatar-container {
	flex-shrink: 0;
}

/* 头像光环 - 按角色显示不同颜色 */
.avatar-ring {
	width: 140rpx;
	height: 140rpx;
	border-radius: 50%;
	padding: 6rpx;
	position: relative;
	overflow: hidden;
	background: linear-gradient(135deg, #00c8d6, #00f2ff);
	box-shadow: 0 0 30rpx rgba(0, 242, 255, 0.4);
	animation: breathe-avatar 3s infinite ease-in-out;
}

.avatar-ring--student {
	background: linear-gradient(135deg, #00c8d6, #00f2ff);
	box-shadow: 0 0 30rpx rgba(0, 242, 255, 0.4);
}

.avatar-ring--instructor {
	background: linear-gradient(135deg, #9b00d6, #bd00ff);
	box-shadow: 0 0 30rpx rgba(189, 0, 255, 0.4);
}

.avatar-ring--staff {
	background: linear-gradient(135deg, #e67e22, #f0c040);
	box-shadow: 0 0 30rpx rgba(240, 192, 64, 0.4);
}

.avatar-ring--admin {
	background: linear-gradient(135deg, #d63031, #ff6b6b);
	box-shadow: 0 0 30rpx rgba(255, 107, 107, 0.4);
}

@keyframes breathe-avatar {
	0%, 100% {
		opacity: 1;
		filter: brightness(1);
	}
	50% {
		opacity: 0.9;
		filter: brightness(1.1);
	}
}

.avatar-ring:active {
	transform: scale(0.95);
}

.avatar-img {
	width: 100%;
	height: 100%;
	border-radius: 50%;
	border: 4rpx solid #050511;
	background: #222;
}

/* ========== 角色信息区域 ========== */
.role-info-area {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.role-username {
	font-size: 36rpx;
	font-weight: 800;
	color: #fff;
}

/* 角色徽章 */
.role-badge {
	display: inline-flex;
	align-items: center;
	gap: 8rpx;
	padding: 6rpx 20rpx;
	border-radius: 20rpx;
	width: fit-content;
	font-size: 24rpx;
}

.role-badge-icon {
	font-size: 20rpx;
}

.role-badge-text {
	font-size: 24rpx;
	font-weight: 600;
	letter-spacing: 2rpx;
}

/* 学员 - 青色 */
.role-badge--student {
	background: rgba(0, 242, 255, 0.15);
	border: 1rpx solid rgba(0, 242, 255, 0.4);
	color: #00f2ff;
}

/* 员工 - 琥珀金 */
.role-badge--staff {
	background: rgba(240, 192, 64, 0.15);
	border: 1rpx solid rgba(240, 192, 64, 0.4);
	color: #f0c040;
}

/* 老师 - 紫色 */
.role-badge--instructor {
	background: rgba(189, 0, 255, 0.15);
	border: 1rpx solid rgba(189, 0, 255, 0.4);
	color: #bd00ff;
}

/* 管理员 - 红色 */
.role-badge--admin {
	background: rgba(255, 107, 107, 0.15);
	border: 1rpx solid rgba(255, 107, 107, 0.4);
	color: #ff6b6b;
}

/* ========== 预约入口 - 赛博青主题 ========== */
.appointment-entry {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
}

.entry-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 0 8rpx;
}

.entry-title-bar {
	display: flex;
	align-items: center;
	gap: 16rpx;
}

.title-indicator {
	width: 8rpx;
	height: 32rpx;
	background: #00f2ff;
	border-radius: 4rpx;
	box-shadow: 0 0 16rpx #00f2ff;
}

.entry-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #fff;
	letter-spacing: 2rpx;
}

.entry-hint {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.4);
}

/* 预约卡片 - 青色呼吸边框 */
.appointment-card {
	border-radius: 32rpx;
	padding: 30rpx;
	position: relative;
	overflow: hidden;
	display: flex;
	justify-content: space-between;
	align-items: center;
	transition: all 0.2s;

	/* 玻璃背景 + 青色渐变 */
	background: linear-gradient(160deg, rgba(0, 242, 255, 0.05) 0%, rgba(20, 20, 35, 0.4) 100%);
	backdrop-filter: blur(15px);
	-webkit-backdrop-filter: blur(15px);

	/* 顶部亮边 */
	border-top: 2rpx solid rgba(0, 242, 255, 0.5);
	border-left: 1rpx solid rgba(255, 255, 255, 0.1);
	border-right: 1rpx solid rgba(255, 255, 255, 0.05);
	border-bottom: 1rpx solid rgba(0, 0, 0, 0.2);

	/* 呼吸动画 */
	animation: breathe-cyan 3s infinite ease-in-out;
}

.appointment-card:active {
	transform: scale(0.98);
}

.appointment-content {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.appointment-content view {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.appointment-label {
	display: inline-block;
	font-size: 20rpx;
	color: #000;
	background: #00f2ff;
	padding: 4rpx 12rpx;
	border-radius: 8rpx;
	font-weight: bold;
	box-shadow: 0 0 16rpx rgba(0, 242, 255, 0.5);
	width: fit-content;
}

.appointment-name {
	font-size: 32rpx;
	font-weight: bold;
	color: #fff;
	margin-top: 8rpx;
}

.appointment-time {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.7);
	margin-top: 4rpx;
}

.appointment-instructor {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.5);
	margin-top: 4rpx;
}

.appointment-arrow {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	background: rgba(0, 242, 255, 0.15);
	border: 1rpx solid rgba(0, 242, 255, 0.3);
	display: flex;
	align-items: center;
	justify-content: center;
	transition: transform 0.2s;
}

.appointment-arrow text {
	font-size: 40rpx;
	color: #00f2ff;
}

.appointment-card:active .appointment-arrow {
	transform: scale(1.1);
}

/* ========== 卡包入口 - 魅惑紫主题 (提亮版) ========== */
.card-wallet-entry {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 30rpx;
	position: relative;
	overflow: hidden;
	transition: all 0.2s;

	/* 提亮：增加背景透明度 */
	background: linear-gradient(160deg, rgba(189, 0, 255, 0.25) 0%, rgba(189, 0, 255, 0.05) 100%);
	backdrop-filter: blur(20px) brightness(1.2);
	-webkit-backdrop-filter: blur(20px) brightness(1.2);

	/* 顶部亮边 */
	border-top: 2rpx solid rgba(189, 0, 255, 0.5);

	/* 呼吸动画 (错开时间) */
	animation: breathe-purple 4s infinite ease-in-out;
	animation-delay: -1s;
}

/* 移除左侧装饰条（用边框替代） */
.card-wallet-entry::before {
	display: none;
}

.card-wallet-entry:active {
	background: rgba(255, 255, 255, 0.08);
	transform: scale(0.98);
}

.wallet-left {
	display: flex;
	align-items: center;
	gap: 24rpx;
}

/* Icon 深黑紫背景，营造凹陷感 */
.wallet-icon {
	width: 90rpx;
	height: 90rpx;
	border-radius: 24rpx;
	background: rgba(20, 0, 40, 0.6);
	border: 1rpx solid rgba(189, 0, 255, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: inset 0 0 20rpx rgba(0, 0, 0, 0.5);
	font-size: 40rpx;
}

.wallet-info {
	display: flex;
	flex-direction: column;
	gap: 6rpx;
}

.wallet-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #fff;
}

.wallet-subtitle {
	font-size: 20rpx;
	color: rgba(230, 180, 255, 0.9);
	text-transform: uppercase;
	letter-spacing: 2rpx;
	font-weight: 600;
}

.wallet-right {
	text-align: right;
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	gap: 8rpx;
}

.wallet-count {
	font-size: 48rpx;
	font-weight: 800;
	color: #fff;
	text-shadow: 0 0 20rpx rgba(189, 0, 255, 0.6);
	line-height: 1;
}

.wallet-badge {
	font-size: 20rpx;
	color: rgba(255, 255, 255, 0.5);
}

/* ========== 底部功能列表 - Clean Glass ========== */
.menu-section {
	overflow: hidden;
	margin-top: 10rpx;
	background: rgba(255, 255, 255, 0.03);
}

.menu-item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 30rpx;
	transition: all 0.2s;
}

.menu-item:active {
	background: rgba(255, 255, 255, 0.05);
}

.menu-item-left {
	display: flex;
	align-items: center;
	gap: 24rpx;
}

.menu-icon {
	width: 48rpx;
	text-align: center;
	font-size: 36rpx;
	transition: color 0.2s;
}

.menu-label {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.8);
}

.menu-arrow {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.3);
	transition: color 0.2s;
}

.menu-item:active .menu-arrow {
	color: #00f2ff;
}

.menu-divider {
	height: 1rpx;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
	margin: 0;
}

/* ========== 未登录状态样式 ========== */
.login-section {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 60rpx 40rpx;
	border-radius: 40rpx;
	background: rgba(255, 255, 255, 0.03);
	border: 1rpx solid rgba(255, 255, 255, 0.05);
	backdrop-filter: blur(10px);
	-webkit-backdrop-filter: blur(10px);
}

.login-avatar-container {
	margin-bottom: 30rpx;
}

.login-avatar-ring {
	width: 160rpx;
	height: 160rpx;
	border-radius: 50%;
	padding: 6rpx;
	background: linear-gradient(135deg, rgba(255,255,255,0.2), rgba(255,255,255,0.1));
	box-shadow: 0 0 30rpx rgba(255, 255, 255, 0.1);
}

.login-info {
	text-align: center;
	margin-bottom: 40rpx;
}

.login-title {
	display: block;
	font-size: 40rpx;
	font-weight: bold;
	color: #fff;
	margin-bottom: 16rpx;
}

.login-desc {
	display: block;
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.5);
}

.login-btn {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 400rpx;
	height: 88rpx;
	background: linear-gradient(135deg, #07c160, #06ad56) !important;
	color: #fff !important;
	font-size: 32rpx;
	font-weight: bold;
	border-radius: 44rpx;
	border: none;
	box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.4);
}

.login-btn::after {
	border: none;
}

.login-btn:active {
	transform: scale(0.95);
	opacity: 0.9;
}

/* 禁用状态的菜单项 */
.menu-item.disabled {
	opacity: 0.6;
	pointer-events: none;
}

/* ========== 未登录 - 紧凑横向布局 ========== */
.login-section--compact {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 30rpx;
	gap: 20rpx;
}

.login-compact-left {
	display: flex;
	align-items: center;
	gap: 20rpx;
	flex: 1;
	min-width: 0;
}

.login-avatar-ring--sm {
	width: 80rpx;
	height: 80rpx;
	flex-shrink: 0;
}

.login-info--inline {
	display: flex;
	flex-direction: column;
	gap: 4rpx;
	min-width: 0;
}

.login-title--sm {
	display: block;
	font-size: 30rpx;
	font-weight: bold;
	color: #fff;
}

.login-section--compact .login-desc {
	font-size: 22rpx;
}

.login-btn--sm {
	width: auto !important;
	min-width: 160rpx;
	height: 68rpx;
	font-size: 28rpx;
	border-radius: 34rpx;
	padding: 0 30rpx;
	flex-shrink: 0;
}
