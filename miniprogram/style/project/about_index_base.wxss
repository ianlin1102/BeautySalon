/* ========== About Index Base - 磨砂黑晶风格 ========== */

page {
	background-color: #050511;
	color: #ffffff;
}

.about-page {
	min-height: 100vh;
}

.about-content {
	position: relative;
	z-index: 1;
	padding: 20rpx 24rpx 40rpx;
}

/* ========== Sections ========== */
.about-section {
	margin-bottom: 36rpx;
}

.section-header {
	display: flex;
	align-items: center;
	gap: 14rpx;
	margin-bottom: 20rpx;
}

.section-indicator {
	width: 6rpx;
	height: 32rpx;
	border-radius: 0 6rpx 6rpx 0;
}

.indicator-cyan {
	background: #2dd4bf;
	box-shadow: 4rpx 0 16rpx rgba(45, 212, 191, 0.4);
}

.indicator-purple {
	background: #6366f1;
	box-shadow: 4rpx 0 16rpx rgba(99, 102, 241, 0.4);
}

.indicator-teal {
	background: #2dd4bf;
	box-shadow: 4rpx 0 16rpx rgba(45, 212, 191, 0.4);
}

.indicator-amber {
	background: #fbbf24;
	box-shadow: 4rpx 0 16rpx rgba(251, 191, 36, 0.4);
}

.section-title {
	font-size: 32rpx;
	font-weight: 700;
	color: #ffffff;
}

/* Section title colors */
.title-cyan { color: #5eead4; }
.title-purple { color: #a78bfa; }
.title-teal { color: #34d399; }
.title-amber { color: #fcd34d; }

/* ========== About Card (shared card style) ========== */
.about-card {
	background: rgba(20, 20, 30, 0.6);
	border: 1rpx solid rgba(255, 255, 255, 0.04);
	border-radius: 24rpx;
	padding: 28rpx;
}

/* ========== Story ========== */
.story-text {
	font-size: 28rpx;
	line-height: 1.8;
	color: rgba(255, 255, 255, 0.75);
	white-space: pre-wrap;
}

/* ========== Instructor Cards ========== */
.instructor-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	background: rgba(20, 20, 30, 0.6);
	border: 1rpx solid rgba(255, 255, 255, 0.04);
	border-radius: 24rpx;
	padding: 28rpx 20rpx;
	text-align: center;
}

.instructor-avatar-wrap {
	margin-bottom: 16rpx;
}

.instructor-avatar {
	width: 140rpx;
	height: 140rpx;
	border-radius: 50%;
	border: 2rpx solid rgba(99, 102, 241, 0.3);
}

.instructor-avatar-placeholder {
	width: 140rpx;
	height: 140rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, rgba(99, 102, 241, 0.3), rgba(45, 212, 191, 0.2));
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 48rpx;
	color: #fff;
	font-weight: bold;
}

.instructor-meta {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6rpx;
}

.instructor-name {
	font-size: 30rpx;
	font-weight: 600;
	color: #ffffff;
}

.instructor-specialty {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.5);
}

.instructor-desc {
	font-size: 24rpx;
	line-height: 1.5;
	color: rgba(255, 255, 255, 0.45);
}

/* Layout: 1 centered */
.instructor-grid-center {
	display: flex;
	justify-content: center;
}
.instructor-grid-center .instructor-card {
	width: 60%;
}

/* Layout: 2 columns */
.instructor-grid-two {
	display: flex;
	gap: 20rpx;
}
.instructor-grid-two .instructor-card {
	flex: 1;
}

/* Layout: 3 columns */
.instructor-grid-three {
	display: flex;
	gap: 16rpx;
}
.instructor-grid-three .instructor-card {
	flex: 1;
}
.instructor-grid-three .instructor-avatar {
	width: 110rpx;
	height: 110rpx;
}
.instructor-grid-three .instructor-avatar-placeholder {
	width: 110rpx;
	height: 110rpx;
	font-size: 36rpx;
}
.instructor-grid-three .instructor-name {
	font-size: 26rpx;
}
.instructor-grid-three .instructor-desc {
	font-size: 22rpx;
}

/* Layout: 4+ scroll */
.instructor-scroll {
	white-space: nowrap;
	-webkit-mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
	mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
}
.instructor-scroll-inner {
	display: inline-flex;
	gap: 20rpx;
	padding: 0 16rpx;
}
.instructor-scroll .instructor-card {
	width: 280rpx;
	flex-shrink: 0;
	white-space: normal;
}

/* ========== Contact Cards ========== */
.contact-list {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.contact-card {
	display: flex;
	flex-direction: row;
	align-items: stretch;
	background: rgba(20, 20, 30, 0.6);
	border: 1rpx solid rgba(255, 255, 255, 0.04);
	border-radius: 24rpx;
	overflow: hidden;
}

.contact-card-accent {
	width: 6rpx;
	flex-shrink: 0;
}

.accent-cyan {
	background: #2dd4bf;
	box-shadow: 4rpx 0 12rpx rgba(45, 212, 191, 0.3);
}

.accent-purple {
	background: #6366f1;
	box-shadow: 4rpx 0 12rpx rgba(99, 102, 241, 0.3);
}

.accent-teal {
	background: #2dd4bf;
	box-shadow: 4rpx 0 12rpx rgba(45, 212, 191, 0.3);
}

.accent-amber {
	background: #fbbf24;
	box-shadow: 4rpx 0 12rpx rgba(251, 191, 36, 0.3);
}

.contact-card-body {
	flex: 1;
	padding: 20rpx 24rpx;
}

.contact-label {
	font-size: 22rpx;
	color: rgba(255, 255, 255, 0.4);
	margin-bottom: 6rpx;
}

.contact-value {
	font-size: 28rpx;
	color: rgba(255, 255, 255, 0.85);
}

/* ========== QR Codes ========== */
.qr-grid {
	display: flex;
	gap: 20rpx;
	justify-content: center;
}

.qr-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	background: rgba(20, 20, 30, 0.6);
	border: 1rpx solid rgba(255, 255, 255, 0.04);
	border-radius: 24rpx;
	padding: 24rpx;
	width: 280rpx;
}

.qr-image {
	width: 220rpx;
	height: 220rpx;
	margin-bottom: 12rpx;
	border-radius: 12rpx;
}

.qr-label {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.5);
}

/* ========== Version ========== */
.version-info {
	text-align: center;
	padding: 40rpx 0 20rpx;
	font-size: 22rpx;
	color: rgba(255, 255, 255, 0.2);
}

/* ========== Loading ========== */
.load-project {
	color: rgba(255, 255, 255, 0.5);
}
