/* 上课排行榜组件样式 - 霓虹蓝紫粉风格 (Compact) */
.rank-list-container {
	background: linear-gradient(160deg, rgba(20, 30, 80, 0.6) 0%, rgba(50, 20, 60, 0.6) 100%);
	backdrop-filter: blur(15px);
	-webkit-backdrop-filter: blur(15px);
	border-radius: 24rpx;
	padding: 24rpx;
	margin: 12rpx 0;
	border: 1px solid rgba(138, 43, 226, 0.3);
	box-shadow: 0 12rpx 48rpx 0 rgba(0, 0, 0, 0.4), inset 0 0 30rpx rgba(138, 43, 226, 0.1);
	position: relative;
	overflow: hidden;
}

/* 氛围背景光斑 */
.rank-list-container::before {
	content: '';
	position: absolute;
	top: -80rpx;
	left: -80rpx;
	width: 200rpx;
	height: 200rpx;
	background: radial-gradient(circle, rgba(0, 242, 255, 0.2), transparent 70%);
	z-index: 0;
	pointer-events: none;
}

.rank-list-container::after {
	content: '';
	position: absolute;
	bottom: -80rpx;
	right: -80rpx;
	width: 200rpx;
	height: 200rpx;
	background: radial-gradient(circle, rgba(255, 0, 222, 0.15), transparent 70%);
	z-index: 0;
	pointer-events: none;
}

/* 榜单标题和切换 */
.rank-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 20rpx;
	position: relative;
	z-index: 1;
}

.rank-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #fff;
	display: flex;
	align-items: center;
	gap: 12rpx;
	text-shadow: 0 0 16rpx rgba(0, 242, 255, 0.5);
}

.rank-title::before {
	content: '';
	display: block;
	width: 6rpx;
	height: 24rpx;
	background: linear-gradient(to bottom, #00f2ff, #7d00ff);
	border-radius: 3rpx;
	box-shadow: 0 0 12rpx #00f2ff;
}

.rank-tabs {
	display: flex;
	background: rgba(0, 0, 0, 0.4);
	border-radius: 32rpx;
	padding: 4rpx;
	border: 1px solid rgba(255, 255, 255, 0.1);
}

.rank-tab {
	padding: 6rpx 20rpx;
	font-size: 22rpx;
	color: rgba(255, 255, 255, 0.6);
	border-radius: 28rpx;
	transition: all 0.3s;
}

.rank-tab.active {
	background: linear-gradient(90deg, #00c6ff, #b721ff);
	color: #fff;
	font-weight: 600;
	box-shadow: 0 4rpx 16rpx rgba(183, 33, 255, 0.4);
}

/* 领奖台容器 */
.podium-container {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	min-height: 220rpx;
	gap: 16rpx;
	position: relative;
	z-index: 1;
	padding-bottom: 10rpx;
}

.podium {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	width: 100%;
	gap: 16rpx;
}

/* 领奖台项目 */
.podium-item {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 30%;
	position: relative;
	animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
	from {
		opacity: 0;
		transform: translateY(40rpx);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

/* 皇冠图标 - 第一名专属 */
.crown-icon {
	position: absolute;
	top: -28rpx;
	font-size: 24rpx;
	filter: drop-shadow(0 0 8rpx rgba(255, 215, 0, 0.8));
	animation: float-crown 3s ease-in-out infinite;
	z-index: 3;
}

@keyframes float-crown {
	0%, 100% { transform: translateY(0); }
	50% { transform: translateY(-4rpx); }
}

/* 头像 */
.podium-avatar {
	width: 64rpx;
	height: 64rpx;
	border-radius: 50%;
	margin-bottom: -16rpx;
	z-index: 2;
	background: #333;
	display: flex;
	align-items: center;
	justify-content: center;
	transition: transform 0.3s;
	overflow: hidden;
}

.avatar-img {
	width: 100%;
	height: 100%;
	border-radius: 50%;
}

.avatar-text {
	font-size: 24rpx;
	font-weight: bold;
	color: #fff;
}

/* 领奖台条 - 动态高度 */
.podium-bar {
	width: 100%;
	border-radius: 12rpx 12rpx 6rpx 6rpx;
	display: flex;
	justify-content: center;
	align-items: flex-end;
	padding-bottom: 10rpx;
	font-weight: 800;
	font-size: 32rpx;
	position: relative;
	color: #fff;
	/* 玻璃质感条纹 */
	background-image: repeating-linear-gradient(
		45deg,
		rgba(255, 255, 255, 0.05) 0px,
		rgba(255, 255, 255, 0.05) 4rpx,
		transparent 4rpx,
		transparent 16rpx
	);
	transition: height 0.5s ease-out;
}

.bar-rank {
	opacity: 0.4;
}

/* 底部信息 */
.podium-info {
	margin-top: 6rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2rpx;
}

.podium-name {
	font-size: 20rpx;
	color: rgba(255, 255, 255, 0.8);
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	width: 100%;
	max-width: 120rpx;
}

.podium-count {
	font-size: 22rpx;
	font-weight: 600;
	color: #fff;
}

/* === 第一名（冠军）: 粉紫霓虹 (Pink/Magenta) === */
.rank-1 {
	animation-delay: 0.2s;
}

.rank-1 .podium-avatar {
	border: 3rpx solid #ff00de;
	box-shadow: 0 0 24rpx rgba(255, 0, 222, 0.6);
	width: 80rpx;
	height: 80rpx;
}

.rank-1 .avatar-text {
	font-size: 30rpx;
}

.rank-1 .podium-bar {
	background-color: rgba(255, 0, 222, 0.2);
	border: 1px solid rgba(255, 0, 222, 0.5);
	border-bottom: none;
	box-shadow: 0 0 30rpx rgba(255, 0, 222, 0.3), inset 0 0 30rpx rgba(255, 0, 222, 0.2);
	text-shadow: 0 0 16rpx rgba(255, 0, 222, 0.8);
}

.rank-1 .podium-bar::before {
	content: '';
	position: absolute;
	bottom: 0;
	left: 10%;
	width: 80%;
	height: 3rpx;
	background: #ff00de;
	box-shadow: 0 0 16rpx #ff00de;
}

/* === 第二名（亚军）: 赛博青蓝 (Cyan/Blue) === */
.rank-2 {
	animation-delay: 0s;
}

.rank-2 .podium-avatar {
	border: 3rpx solid #00f2ff;
	box-shadow: 0 0 20rpx rgba(0, 242, 255, 0.5);
}

.rank-2 .podium-bar {
	background-color: rgba(0, 242, 255, 0.15);
	border: 1px solid rgba(0, 242, 255, 0.5);
	border-bottom: none;
	box-shadow: 0 0 24rpx rgba(0, 242, 255, 0.2), inset 0 0 24rpx rgba(0, 242, 255, 0.1);
	text-shadow: 0 0 12rpx rgba(0, 242, 255, 0.8);
}

.rank-2 .podium-bar::before {
	content: '';
	position: absolute;
	bottom: 0;
	left: 10%;
	width: 80%;
	height: 3rpx;
	background: #00f2ff;
	box-shadow: 0 0 16rpx #00f2ff;
}

/* === 第三名（季军）: 深邃电紫 (Deep Purple) === */
.rank-3 {
	animation-delay: 0.4s;
}

.rank-3 .podium-avatar {
	border: 3rpx solid #7d00ff;
	box-shadow: 0 0 20rpx rgba(125, 0, 255, 0.5);
}

.rank-3 .podium-bar {
	background-color: rgba(125, 0, 255, 0.15);
	border: 1px solid rgba(125, 0, 255, 0.5);
	border-bottom: none;
	box-shadow: 0 0 24rpx rgba(125, 0, 255, 0.2), inset 0 0 24rpx rgba(125, 0, 255, 0.1);
	text-shadow: 0 0 12rpx rgba(125, 0, 255, 0.8);
}

.rank-3 .podium-bar::before {
	content: '';
	position: absolute;
	bottom: 0;
	left: 10%;
	width: 80%;
	height: 3rpx;
	background: #7d00ff;
	box-shadow: 0 0 16rpx #7d00ff;
}

/* === 4-10名列表 === */
.rank-list-section {
	margin-top: 16rpx;
	padding-top: 16rpx;
	border-top: 1px solid rgba(255, 255, 255, 0.1);
	position: relative;
	z-index: 1;
}

.rank-list-item {
	display: flex;
	align-items: center;
	padding: 12rpx 8rpx;
	border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.rank-list-item:last-child {
	border-bottom: none;
}

.list-rank {
	width: 48rpx;
	font-size: 24rpx;
	font-weight: 600;
	color: rgba(255, 255, 255, 0.5);
	text-align: center;
	flex-shrink: 0;
}

.list-avatar {
	width: 48rpx;
	height: 48rpx;
	border-radius: 50%;
	background: rgba(255, 255, 255, 0.1);
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 16rpx;
	flex-shrink: 0;
	overflow: hidden;
	border: 1px solid rgba(255, 255, 255, 0.15);
}

.list-avatar-img {
	width: 100%;
	height: 100%;
	border-radius: 50%;
}

.list-avatar-text {
	font-size: 20rpx;
	font-weight: bold;
	color: rgba(255, 255, 255, 0.7);
}

.list-name {
	flex: 1;
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.8);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.list-count {
	font-size: 24rpx;
	font-weight: 600;
	color: rgba(255, 255, 255, 0.9);
	flex-shrink: 0;
	margin-left: 16rpx;
}

/* === 我的排名行 (10+1) === */
.my-rank-section {
	margin-top: 16rpx;
	padding-top: 16rpx;
	border-top: 1px solid rgba(255, 255, 255, 0.1);
	position: relative;
	z-index: 1;
}

.my-rank-row {
	background: rgba(0, 242, 255, 0.08);
	border-radius: 8rpx;
	border: 1px solid rgba(0, 242, 255, 0.2);
}

.list-rank.unranked {
	font-size: 18rpx;
	width: auto;
	min-width: 48rpx;
	color: rgba(255, 255, 255, 0.4);
}

/* 空状态 */
.rank-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 40rpx 0;
}

.empty-icon {
	font-size: 60rpx;
	margin-bottom: 12rpx;
	opacity: 0.5;
}

.empty-text {
	font-size: 24rpx;
	color: #999;
}

/* (你) 标签 */
.is-me-tag {
	font-size: 18rpx;
	color: #00f2ff;
	margin-left: 4rpx;
	text-shadow: 0 0 8rpx rgba(0, 242, 255, 0.5);
}
